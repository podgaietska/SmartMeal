# Copy to .env and fill in. Never commit .env.

# Which chat model the agent uses, as "<provider>:<model>".
# Examples: "openai:gpt-4.1-mini", "anthropic:claude-sonnet-5-5"
SMARTMEAL_MODEL=openai:gpt-4.1-mini

# API key for the provider above (only the one you use is needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: LangSmith tracing (free Developer tier)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smartmeal
